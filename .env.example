# Copy this file to .env, replace the placeholder, then run: source .env
# The Python scripts do not load .env automatically.
export OPENAI_API_KEY='your-tritonai-api-key'

# Optional: change these to use another OpenAI-compatible endpoint or model.
# These are the defaults used by the project.
# export LLM_BASE_URL='https://tritonai-api.ucsd.edu/v1'
# export LLM_MODEL='api-muse-glimmer-30b'

# LLM_API_KEY takes precedence over OPENAI_API_KEY when both are set.
# export LLM_API_KEY='your-api-key'
# LLM_BASE_URL takes precedence over OPENAI_BASE_URL when both are set.
# export OPENAI_BASE_URL='https://example.com/v1'

# Optional experiment settings (shown with their defaults).
# export FAULT_TIMEOUT_S='5'
# export TASK_CASH='legacy'  # Use 'ample' for the controlled timeout experiment.
